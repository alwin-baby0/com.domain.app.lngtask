{
  "compilerOptions": {
    "outDir": "build-ts",
    "target": "ES2019",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/**/*.ts"
  ]
}